# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String (defaults to embedded in-memory if empty)
MONGO_URI=mongodb://localhost:27017/freelanceflow

# JWT Secret Key
JWT_SECRET=freelanceflow_super_secret_jwt_key_2026_production_grade

# Client URL (for CORS if running separate frontend)
CLIENT_URL=http://localhost:3000

# Optional Gemini API Key
GEMINI_API_KEY=

