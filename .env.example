# MongoDB Connection URI (e.g., mongodb+srv://<username>:<password>@cluster.mongodb.net/freelanceflow?retryWrites=true&w=majority)
MONGO_URI=

# Secret key for JWT signing (use a strong random string in production)
JWT_SECRET=

# Allowed client origins for CORS (comma-separated or single URL, e.g., https://your-domain.vercel.app)
CLIENT_URL=

# Optional: Port for local standalone server (defaults to 3000)
PORT=3000

# Optional: Environment mode (production, development, test)
NODE_ENV=production

# Optional: Custom API URL if frontend is deployed separately from the backend
VITE_API_URL=
